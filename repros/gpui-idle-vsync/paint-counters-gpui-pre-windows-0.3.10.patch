diff --git a/b/src/stats.rs b/src/stats.rs
new file mode 100644
index 0000000..2d19657
--- /dev/null
+++ b/src/stats.rs
@@ -0,0 +1,107 @@
+//! Scratch instrumentation for zed#66221, not meant for upstream.
+//!
+//! `GPUI_PAINT_STATS=<file>` appends one line of cumulative counters per
+//! second. `GPUI_VSYNC_GUARD=0` turns the hidden/minimized guard off.
+
+use std::{
+    cell::Cell,
+    io::Write,
+    sync::{
+        OnceLock,
+        atomic::{AtomicU64, Ordering::Relaxed},
+    },
+    time::{Duration, Instant},
+};
+
+macro_rules! counters {
+    ($($name:ident),* $(,)?) => {
+        $(pub static $name: AtomicU64 = AtomicU64::new(0);)*
+        fn snapshot() -> String {
+            let mut s = String::new();
+            $(s.push_str(&format!(" {}={}", stringify!($name).to_lowercase(), $name.load(Relaxed)));)*
+            s
+        }
+    };
+}
+
+counters!(
+    // VSyncProvider thread
+    VSYNC_TICKS,
+    INVALIDATES,
+    SKIPPED_HIDDEN,
+    // GPUI window procedure (outermost calls only for the time)
+    WND_MSGS,
+    WND_NS,
+    PAINT_MSGS,
+    PAINT_NS,
+    // draw_window
+    PAINT_NO_CALLBACK,
+    FRAME_CALLBACKS,
+    FRAME_NS,
+    // WM_PAINT left to DefWindowProcW (no frame callback)
+    DEF_PAINT,
+    DEF_PAINT_NS,
+    // platform (dispatcher) window procedure: foreground tasks, timers
+    PLATFORM_MSGS,
+    PLATFORM_NS,
+    // GetMessageW loop iterations
+    LOOP_MSGS,
+);
+
+thread_local! {
+    static DEPTH: Cell<u32> = const { Cell::new(0) };
+}
+
+pub fn guard_enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("GPUI_VSYNC_GUARD").map_or(true, |v| v != "0"))
+}
+
+pub fn start_dumper() {
+    static STARTED: OnceLock<()> = OnceLock::new();
+    let Ok(path) = std::env::var("GPUI_PAINT_STATS") else {
+        return;
+    };
+    if STARTED.set(()).is_err() {
+        return;
+    }
+    let start = Instant::now();
+    std::thread::Builder::new()
+        .name("paint-stats".into())
+        .spawn(move || {
+            let Ok(mut file) = std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(&path)
+            else {
+                return;
+            };
+            writeln!(file, "# guard={}", guard_enabled()).ok();
+            loop {
+                std::thread::sleep(Duration::from_secs(1));
+                writeln!(file, "t={:.1}{}", start.elapsed().as_secs_f64(), snapshot()).ok();
+            }
+        })
+        .ok();
+}
+
+/// Times an outermost call on this thread into `ns`, counting every call.
+pub fn timed<R>(count: &AtomicU64, ns: &AtomicU64, f: impl FnOnce() -> R) -> R {
+    count.fetch_add(1, Relaxed);
+    let outer = DEPTH.with(|d| {
+        let v = d.get();
+        d.set(v + 1);
+        v == 0
+    });
+    let start = Instant::now();
+    let r = f();
+    if outer {
+        ns.fetch_add(start.elapsed().as_nanos() as u64, Relaxed);
+    }
+    DEPTH.with(|d| d.set(d.get() - 1));
+    r
+}
+
+pub fn add_ns(ns: &AtomicU64, start: Instant) {
+    ns.fetch_add(start.elapsed().as_nanos() as u64, Relaxed);
+}
